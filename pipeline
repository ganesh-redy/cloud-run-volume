pipeline {
    agent any
    environment {
        IMAGE_NAME = "okay"
        GOOGLE_APPLICATION_CREDENTIALS = credentials('gcp-owner')
    }
    stages {
        stage("Checkout Code") {
            steps {
                git branch: "main", url: "https://github.com/ganesh-redy/cloud-run-volume.git"
            }
        }
        stage("Build Docker Image") {
            steps {
                sh '''
                docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                '''
            }
        }
        stage("Authenticate with Docker Hub") {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: "docker-hub-credential",
                    usernameVariable: "DOCKER_USER",
                    passwordVariable: "DOCKER_PASS"
                )]) {
                    sh '''
                    echo "$DOCKER_PASS" | docker login -u "$DOCKER_USER" --password-stdin
                    '''
                }
            }
        }
        stage("Push to Docker Hub") {
            steps {
                sh '''
                docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ganesh6498/${IMAGE_NAME}:${BUILD_NUMBER}
                docker push ganesh6498/${IMAGE_NAME}:${BUILD_NUMBER}
                '''
            }
        }
        stage("Authenticate with GCP") {
            steps {
                script {
                    sh '''
                    gcloud auth activate-service-account --key-file=$GOOGLE_APPLICATION_CREDENTIALS
                    gcloud auth configure-docker us-central1-docker.pkg.dev
                    '''
                }
            }
        }
        stage("Push to Google Artifact Registry") {
            steps {
                sh '''
                docker tag ${IMAGE_NAME}:${BUILD_NUMBER} us-central1-docker.pkg.dev/mythic-inn-420620/my-docker-repo1/okay:${BUILD_NUMBER}
                docker push us-central1-docker.pkg.dev/mythic-inn-420620/my-docker-repo1/okay:${BUILD_NUMBER}
                '''
            }
        }
        stage("Terraform Deployment") {
            steps {
                sh '''
                terraform init
                terraform plan -var="tag=${BUILD_NUMBER}"
                terraform apply -var="tag=${BUILD_NUMBER}" --auto-approve
                '''
            }
        }
    }
}

